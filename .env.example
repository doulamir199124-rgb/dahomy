# متغيرات البيئة — انسخ هذا الملف إلى .env.local محليًا، وأضف نفس القيم في
# Vercel → Settings → Environment Variables (بلا أي قيم حقيقية هنا إطلاقًا)

# إلزاميان — قاعدة Turso المجانية (turso db create ثم turso db tokens create)
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# خدمة دمج الفيديو (Video Merger API v2) — ضع الرابط عند توفره
MERGER_API_BASE=

# اختياري — إن ضُبط يُطلب Authorization: Bearer <token> على /mcp
MCP_ACCESS_TOKEN=

# اختياري — تجاوز أسماء الموديلات لدى المزودين إن لزم
KIE_IMAGE_MODEL=
KIE_VIDEO_MODEL=
COMETAPI_IMAGE_MODEL=
COMETAPI_VIDEO_MODEL=
